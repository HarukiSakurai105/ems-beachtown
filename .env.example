# Tạo chuỗi ngẫu nhiên tối thiểu 32 ký tự
EMS_SESSION_SECRET=

# Mật khẩu được băm bằng scrypt: node scripts/hash-password.mjs "mat-khau"
EMS_ADMIN_USERS=[{"email":"admin@example.com","name":"Quản trị EMS","role":"admin","passwordHash":""}]

# Supabase server-side. Ưu tiên Secret key mới (sb_secret_...).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Có thể dùng SUPABASE_SERVICE_ROLE_KEY nếu dự án chỉ có khóa legacy.

# Tùy chọn: tiếp nhận form hỗ trợ qua Discord
EMS_DISCORD_WEBHOOK_URL=
